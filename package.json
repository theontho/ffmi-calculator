{
  "name": "ffmi-calculator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "overrides": {
    "next": {
      "sharp": "0.35.3"
    }
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "ffmi": "node bin/ffmi.mjs",
    "generate:locale-data": "node scripts/generate-locale-defaults.mjs",
    "build": "next build",
    "build:pages": "GITHUB_ACTIONS=true GITHUB_REPOSITORY=theontho/ffmi-calculator next build",
    "lint": "eslint .",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "test:pages": "npm run build:pages && npm run validate:pages",
    "validate:pages": "node scripts/validate-pages-export.mjs",
    "serve:test-pages": "npm run build:pages && npm run validate:pages && node scripts/serve-pages-export.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "bin": {
    "ffmi": "./bin/ffmi.mjs"
  }
}
